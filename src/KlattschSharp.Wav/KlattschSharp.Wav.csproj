<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0</TargetFrameworks>
    <RootNamespace>KlattschSharp.Wav</RootNamespace>
    <AssemblyName>KlattschSharp.Wav</AssemblyName>

    <PackageId>KlattschSharp.Wav</PackageId>
    <Description>RIFF/WAVE encoder for KlattschSharp. Writes mono 16-bit PCM with optional peak normalization and LIST/INFO metadata.</Description>
    <PackageTags>klatt;formant;synthesizer;speech;dsp;audio;wav;riff</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
